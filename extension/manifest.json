{
  "name": "LumaLatch",
  "version": "0.2.0",
  "description": "Watch Jellyfin together over your own signaling server.",
  "manifest_version": 3,
  "minimum_chrome_version": "116",
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "LumaLatch",
    "default_popup": "popup.html"
  },
  "permissions": [
    "scripting",
    "storage",
    "activeTab"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "key": ""
}
